install_vnstat(){
    echo "[INFO] Installing vnStat v2.12 from source..."

    VNSTAT_VER="2.12"

    cd /tmp || exit
    curl -LO "https://humdi.net/vnstat/vnstat-${VNSTAT_VER}.tar.gz"
    tar xf "vnstat-${VNSTAT_VER}.tar.gz"
    cd "vnstat-${VNSTAT_VER}" || exit

    ./configure --prefix=/usr --sysconfdir=/etc && make && make install

    # Cleanup
    cd /tmp && rm -rf "vnstat-${VNSTAT_VER}"*

    # Ensure the service is running
    systemctl enable vnstat
    systemctl restart vnstat

    echo "[INFO] vnStat $(vnstat --version) installed."
}

install_xray(){
    echo "[INFO] Installing latest official Xray-core..."

    mkdir -p /etc/xray /var/log/xray /run/xray
    chown -R firenet:firenet /etc/xray /var/log/xray /run/xray

    echo "$DOMAIN" > /etc/xray/domain
    curl -s ipinfo.io/city > /etc/xray/city
    curl -s ipinfo.io/org | cut -d " " -f 2-10 > /etc/xray/isp

    # Detect latest official Xray version
    XRAY_TAG="$(curl -s https://api.github.com/repos/XTLS/Xray-core/releases/latest | jq -r .tag_name)"

    if [[ -z "$XRAY_TAG" || "$XRAY_TAG" == "null" ]]; then
        echo "[ERROR] Failed to fetch latest Xray version"
        exit 1
    fi

    echo "[INFO] Latest Xray version: $XRAY_TAG"

    # Download & install (amd64)
    cd /tmp || exit
    curl -fsSL "https://github.com/XTLS/Xray-core/releases/download/${XRAY_TAG}/Xray-linux-64.zip" -o xray.zip

    unzip -o xray.zip xray
    install -m 755 xray /usr/sbin/xray

    rm -f xray.zip xray
	
	 wget -O /etc/xray/xray_stats.sh "https://mediatekvpn.uk/sabrinavpn/v2ray/xray_stats.sh" >/dev/null 2>&1
    chmod +x /etc/xray/xray_stats.sh

    # Fetch config and inject UUID
    wget -q -O /etc/xray/config.json \
      "https://mediatekvpn.uk/sabrinavpn/v2ray/v2/netvpro_config.json"

    sed -i "s/DexterEskalarte/${UUID}/g" /etc/xray/config.json

    # =========================================================
    # PERMANENT GEOSITE LUNAS FOR XHTTP / VLESS CORES
    # =========================================================
    echo "[INFO] Patching config.json to remove obsolete geosite tags..."
    python3 -c '
import json
try:
    with open("/etc/xray/config.json", "r") as f:
        data = json.load(f)
    if "dns" in data: 
        del data["dns"]
    if "routing" in data: 
        del data["routing"]
    with open("/etc/xray/config.json", "w") as f:
        json.dump(data, f, indent=4)
    print("[INFO] Patch successful: Routing and DNS blocks cleaned.")
except Exception as e:
    print(f"[ERROR] Failed to patch config: {e}")
'
    # =========================================================

    # systemd service
    cat >/etc/systemd/system/xray.service <<'EOF'
[Unit]
Description=Xray Service
Documentation=https://github.com/XTLS/Xray-core
After=network.target nss-lookup.target

[Service]
User=firenet
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/sbin/xray run -config /etc/xray/config.json
Restart=on-failure
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable xray
    systemctl restart xray

    echo "[INFO] Xray installed and running (TLS + WS ready)"
}

dir_xray() {
    echo "[INFO] Creating Xray & Firenet directories..."

    # Base directories
    mkdir -p /etc/xray
    mkdir -p /var/log/xray
    mkdir -p /etc/firenet/{database,public_html,theme}

    # Database subdirectories
    mkdir -p /etc/firenet/database/{vmess,vless,trojan,ssh,shadowsocks}

    # Log files
    touch /var/log/xray/access.log
    touch /var/log/xray/error.log

    # Database files
    touch /etc/firenet/database/vmess/vmess.db
    touch /etc/firenet/database/vless/vless.db
    touch /etc/firenet/database/trojan/trojan.db
    touch /etc/firenet/database/ssh/ssh.db
    touch /etc/firenet/database/shadowsocks/shadowsocks.db

    # Install log
    touch /etc/firenet/install.log

    # Ownership
    chown -R firenet:firenet /etc/xray /var/log/xray /etc/firenet

    # Secure permissions
    chmod 750 /etc/xray
    chmod 750 /var/log/xray
    chmod 640 /var/log/xray/*.log
    chmod 750 /etc/firenet
}

install_ssl() {
    echo "[INFO] Installing SSL (Let's Encrypt via acme.sh)"

    mkdir -p /etc/xray

    # Stop nginx temporarily (safe)
    systemctl stop nginx || true

    # Install official acme.sh
    curl -fsSL https://get.acme.sh | sh -s email=admin@"$DOMAIN"

    export PATH="$HOME/.acme.sh:$PATH"

    ~/.acme.sh/acme.sh --set-default-ca --server letsencrypt

    # Issue ECC certificate
    ~/.acme.sh/acme.sh --issue \
        -d "$DOMAIN" \
        --standalone \
        -k ec-256

