    chmod 755 /usr/share/squid/errors/English/*

    systemctl restart squid

    # Download monitor scripts
    wget -q 'https://mediatekvpn.uk/sabrinavpn/v2ray/monitorzzz' -O /etc/.monitor
    wget -q 'https://mediatekvpn.uk/sabrinavpn/v2ray/xray' -O /etc/.xray
