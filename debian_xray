detect_distro() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        DISTRO=$ID
        VERSION=$VERSION_ID
    else
        echo "[ERROR] Cannot detect distribution."
        exit 1
    fi
    echo "[INFO] Detected: $DISTRO $VERSION"
}

setup_nodejs() {
    if ! command -v node >/dev/null 2>&1; then
        echo "[INFO] Installing Node.js LTS (20.x)..."
        curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
        apt-get install -yq nodejs
    else
        echo "[INFO] Node.js already installed (version $(node -v))"
    fi
}

base_package() {
    echo "[INFO] Starting base package installation..."

    # Disable IPv6 for performance
    sysctl -w net.ipv6.conf.all.disable_ipv6=1
    sysctl -w net.ipv6.conf.default.disable_ipv6=1
    echo "net.ipv6.conf.all.disable_ipv6=1" >> /etc/sysctl.conf
    echo "net.ipv6.conf.default.disable_ipv6=1" >> /etc/sysctl.conf

    # Update and install all packages in one go
    apt-get update -yq
    apt-get upgrade -yq

    # Pre-seed iptables-persistent to avoid prompts
    echo iptables-persistent iptables-persistent/autosave_v4 boolean true | debconf-set-selections
    echo iptables-persistent iptables-persistent/autosave_v6 boolean true | debconf-set-selections

    apt-get install -yq \
        nginx zip netcat-traditional bash-completion vnstat curl socat \
        xz-utils wget apt-transport-https dnsutils screen chrony tar ruby \
        unzip p7zip-full python3-pip libc6 gnupg gnupg2 gnupg1 msmtp-mta \
        ca-certificates bsd-mailx iptables iptables-persistent \
        netfilter-persistent neofetch default-mysql-client iftop bzip2 \
        gzip lsof bc htop sed openssl wireguard-tools stunnel4 tmux \
        libsqlite3-dev cron wondershaper net-tools jq openvpn easy-rsa \
        python3-certbot-nginx tuned fail2ban build-essential libgd-dev squid

    # Install Node.js
    setup_nodejs

    # Clean apt cache
    apt-get clean
}

first_setup() {
    echo "[INFO] Starting first setup..."

    # Disable history globally
    if ! grep -q "set +o history" /etc/profile; then
        echo 'set +o history' >> /etc/profile
    fi

    # Install banner
    if [ ! -f /etc/banner ]; then
        wget -q -O /etc/banner \
          "https://mediatekvpn.uk/sabrinavpn/v2ray/banner"
        chmod +x /etc/banner
        echo "[INFO] Banner installed."
    else
        echo "[INFO] Banner already exists."
    fi

    # Backup sshd_config BEFORE overwrite
    if [ -f /etc/ssh/sshd_config ]; then
        cp /etc/ssh/sshd_config \
           /etc/ssh/sshd_config.bak.$(date +%F-%H%M)
    fi

    # Download sshd_config
    wget -q -O /etc/ssh/sshd_config.new \
      "https://mediatekvpn.uk/sabrinavpn/v2ray/sshd_config"

    # Validate SSH config to avoid lockout
    if sshd -t -f /etc/ssh/sshd_config.new; then
        mv /etc/ssh/sshd_config.new /etc/ssh/sshd_config
        chmod 644 /etc/ssh/sshd_config
        systemctl restart ssh || systemctl restart sshd
        echo "[INFO] SSH config applied."
    else
        echo "[ERROR] SSH config invalid, restoring backup."
        rm -f /etc/ssh/sshd_config.new
    fi

    # Fetch ipserver
    wget -q -O /etc/ipserver \
      "https://mediatekvpn.uk/sabrinavpn/v2ray/ipserver"
    chmod +x /etc/ipserver

    # Execute ipserver
    bash /etc/ipserver >/dev/null 2>&1

    # Add user firenet
    if ! id firenet &>/dev/null; then
        useradd -M -s /usr/sbin/nologin firenet
        echo "[INFO] User 'firenet' created."
    else
        echo "[INFO] User 'firenet' already exists."
    fi

    usermod -aG sudo,firenet firenet

    echo "[INFO] First setup completed."
}

install_squid(){
    echo "[INFO] Configuring Squid proxy..."

    # Backup existing config and create a new one to avoid duplicates
    SQUID_CONFIG="/etc/squid/squid.conf"
    [ -f "$SQUID_CONFIG" ] && mv "$SQUID_CONFIG" "$SQUID_CONFIG.bak.$(date +%F-%H%M)"

    cat > "$SQUID_CONFIG" <<-EOF
acl Firenet dst $(curl -s https://api.ipify.org)
http_port 8080
http_port 8181
visible_hostname Proxy
acl PURGE method PURGE
acl HEAD method HEAD
acl POST method POST
acl GET method GET
acl CONNECT method CONNECT
http_access allow Firenet
http_reply_access allow all
http_access deny all
icp_access allow all
always_direct allow all
visible_hostname Firenet-Proxy
error_directory /usr/share/squid/errors/English
EOF

    # Custom error page
    ERROR_PAGE="/usr/share/squid/errors/English/ERR_INVALID_URL"
