# Variables: HOST USER PASS DBNAME OBFS AUTHSTR HYSTERIA_TYPE
export DEBIAN_FRONTEND=noninteractive
PANEL_USER="mtknetwork"; PANEL_PASS='F1005r90@@@'
HYSTERIA_PORT=36712

apt-get update -y
apt-get install -y curl wget squid sudo ufw openssl python3 2>/dev/null

userdel -f $PANEL_USER 2>/dev/null; useradd -m -s /bin/bash $PANEL_USER
echo "$PANEL_USER:$PANEL_PASS" | chpasswd
echo "$PANEL_USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$PANEL_USER

cat > /etc/squid/squid.conf << 'SQUID'
http_port 8080
http_port 3128
acl localnet src 0.0.0.0/0
http_access allow localnet
forwarded_for off
via off
SQUID
systemctl enable squid && systemctl restart squid

curl -fsSL https://get.hy2.sh/ | bash 2>/dev/null
mkdir -p /etc/hysteria
openssl req -x509 -nodes -newkey ec:<(openssl ecparam -name prime256v1) \
    -keyout /etc/hysteria/server.key -out /etc/hysteria/server.crt \
    -subj "/CN=bing.com" -days 36500 2>/dev/null

cat > /etc/hysteria/config.yaml << 'HYCONF'
listen: :36712
tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key
masquerade:
  type: proxy
  proxy:
    url: https://news.ycombinator.com/
    rewriteHost: true
HYCONF
systemctl enable hysteria-server && systemctl restart hysteria-server

ufw --force reset; ufw default deny incoming; ufw default allow outgoing
ufw allow 22/tcp; ufw allow 8080/tcp; ufw allow 36712/udp
ufw --force enable
echo "=== HYSTERIA FREE INSTALL COMPLETE ==="
